# CycloneGuard GVMC - Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ====================
# Database Configuration
# ====================
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cycloneguard_gvmc

# ====================
# Security Configuration
# ====================
# Generate a strong secret key for production: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-use-secrets-token-urlsafe-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ====================
# Microsoft Entra ID (Azure AD)
# ====================
ENTRA_CLIENT_ID=your-entra-client-id
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback

# ====================
# Google OAuth2
# ====================
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create "OAuth 2.0 Client ID" → Application type: Web application
# 3. Add Authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ====================
# Redis Configuration
# ====================
REDIS_URL=redis://localhost:6379/0
# For production Redis Cloud: redis://username:password@redis-host:port/0

# ====================
# CORS Configuration
# ====================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# ====================
# Application Configuration
# ====================
PROJECT_NAME=CycloneGuard GVMC Backend
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development

# ====================
# GIS Configuration
# ====================
GIS_TILE_SERVER_URL=https://tile.openstreetmap.org

# ====================
# Media Storage
# ====================
MEDIA_STORAGE_PATH=./storage/media

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ====================
# Logging
# ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ====================
# Monitoring (Optional)
# ====================
# Sentry for error tracking
SENTRY_DSN=

# Prometheus metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# ====================
# Email Configuration (Optional)
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@gvmc.gov.in

# ====================
# SMS Gateway (Optional)
# ====================
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=GVMC

# ====================
# AI/ML Configuration (Optional)
# ====================
AI_MODEL_PATH=./models
ENABLE_AI_FEATURES=true

# ====================
# WebSocket Configuration
# ====================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000
